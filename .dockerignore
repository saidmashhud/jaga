# Прошлая сборка не должна попадать в новую: COPY . . тащил dist от 17 июля,
# и в образе оказывались два разных бандла — старый рядом с новым. Какой из
# них подхватит index.html, решала случайность.
apps/*/dist
packages/*/dist
storybook-static

# Зависимости ставит сама сборка под свою платформу. Скопированные с макбука
# бинарные пакеты в alpine всё равно не работают.
node_modules
**/node_modules

.git
